# Copy this file to .env for local development, or set these two in Vercel ->
# Project -> Settings -> Environment Variables.
#
# Only the anon/public key goes here. NEVER put the service_role key or the
# secret key in this file or in Vercel env vars for this project - both bypass
# every security rule and must stay off any machine that isn't the Supabase
# dashboard itself.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
